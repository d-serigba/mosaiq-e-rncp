FLASK_APP=wsgi.py
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi
# Sans DATABASE_URL, l'application utilise SQLite (dev.db)
DATABASE_URL=postgresql://microblog_user:motdepasse@localhost:5432/microblog
# 0 en développement HTTP local, 1 en production (HTTPS)
SESSION_COOKIE_SECURE=0
